# Application configuration
APP_NAME=Doordarshan
SECRET_KEY=replace_with_a_generated_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Host-side PostgreSQL URL for running the application outside Docker.
# Docker Compose overrides this with the internal PostgreSQL service URL.
DATABASE_URL=postgresql+psycopg://doordarshan:replace_with_url_safe_password@localhost:5432/doordarshan

# Required by the ICE configuration endpoint.
METERED_USERNAME=YOUR_METERED_USERNAME
METERED_CREDENTIAL=YOUR_METERED_CREDENTIAL

# Docker Compose PostgreSQL configuration.
# Use a long URL-safe password (letters, numbers, hyphens, and underscores).
POSTGRES_DB=doordarshan
POSTGRES_USER=doordarshan
POSTGRES_PASSWORD=replace_with_a_long_url_safe_password

# Host port for the application.
APP_PORT=8000
