```gitignore
# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*
!.env.example

# Database
*.db
*.sqlite3

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Python testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
junit.xml

# Alembic cache
alembic/__pycache__/

# Build artifacts
build/
dist/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Logs
*.log
```